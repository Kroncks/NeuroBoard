    "sd",
    "neopixel",
    "ece"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kroncks/NeuroBoard.git"
  },
  "authors": [
    {
      "name": "Kroncks"
    }
  ],
  "license": "MIT",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
